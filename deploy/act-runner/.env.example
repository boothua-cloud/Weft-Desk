# 复制成 .env 后填自己的值
# 和 Gitea 同机部署，走内网。改成你实际的地址：
#   A. 用宿主内网 IP（Gitea 端口映射到 0.0.0.0/内网卡）
#   B. 用服务名（两边同 docker network）http://gitea:3000
GITEA_URL=http://10.0.1.5:3000

# 注册令牌：站点管理 → Actions → Runners → 创建 Runner 令牌
# （实例级令牌，能跑所有仓库；仓库级的在 仓库设置 → Actions → Runners 里拿）
RUNNER_TOKEN=

# 显示名，同一实例下不要重复
RUNNER_NAME=weft-desktop
